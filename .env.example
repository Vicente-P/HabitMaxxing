# Base de datos (Transaction Pooler de Supabase — puerto 6543)
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI y migraciones (conexión directa o Session Pooler, puerto 5432)
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js v5
AUTH_SECRET="your-secret-here"
AUTH_URL="https://tu-app.vercel.app"  # Producción
# AUTH_URL="http://localhost:3000"    # Desarrollo

# Origen confiable del servidor para POST /api/habits (sin NEXT_PUBLIC_)
APP_ORIGIN="http://localhost:3000"
# Producción: APP_ORIGIN="https://habit-maxxing.vercel.app"
# Cada preview: configurar explícitamente su propia URL HTTPS exacta; sin comodines.
